# Copy these into a .env file next to server.js (or set them in the setup UI —
# the UI writes them here for you). Never commit this file anywhere.
#
# Required for the WhatsApp pairing UI when exposed beyond localhost:
ADMIN_PASSWORD=
# Port for the setup UI (default 3001). Bind 0.0.0.0 to reach it from your laptop.
BOT_BIND=0.0.0.0
BOT_PORT=3001

# Gemini API key for trade parsing (https://aistudio.google.com/apikey — free tier).
# This is the suggested default; any OpenAI-compatible LLM works instead (below).
GEMINI_API_KEY=
# Optional model override (default gemini-3.5-flash-lite).
GEMINI_MODEL=

# Generic LLM provider (optional): any OpenAI-compatible chat-completions API —
# OpenAI, OpenRouter, Together, Ollama, vLLM, LM Studio. Takes precedence over
# GEMINI_API_KEY when set.
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=

# Database: the dashboard's live data layer. Supabase's free tier is the
# suggested default, but anything exposing PostgREST works (self-hosted
# PostgREST, etc.) — the push script and dashboard only speak REST.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Group name query used by the hourly pull (matches read.js behavior).
WA_GROUP_QUERY="your group name"

# Market data for outcome scoring: "tradingview" (default, uses your connected
# TradingView account — broadest coverage) or "yahoo" (free, no key — US
# stocks, ETFs and crypto via Yahoo Finance).
MARKET_DATA_PROVIDER=tradingview

# Chromium for whatsapp-web.js (ARM64 has no puppeteer-bundled build).
# IMPORTANT: use the real binary, NOT /snap/bin/chromium — snap's launcher
# refuses to run from inside a systemd service ("not a snap cgroup").
PUPPETEER_EXECUTABLE_PATH=/snap/chromium/current/usr/lib/chromium-browser/chrome
