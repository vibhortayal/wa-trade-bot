# Copy these into a .env file next to server.js (or set them in the setup UI —
# the UI writes them here for you). Never commit this file anywhere.
#
# Required for the WhatsApp pairing UI when exposed beyond localhost:
ADMIN_PASSWORD=
# Port for the setup UI (default 3001). Bind 0.0.0.0 to reach it from your laptop.
BOT_BIND=0.0.0.0
BOT_PORT=3001

# Gemini API key for trade parsing (https://aistudio.google.com/apikey — free tier).
GEMINI_API_KEY=
# Optional model override (default gemini-3.5-flash-lite).
GEMINI_MODEL=

# Supabase: the dashboard's live data layer.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Group name query used by the hourly pull (matches read.js behavior).
WA_GROUP_QUERY="your group name"
