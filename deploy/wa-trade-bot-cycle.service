[Unit]
Description=Trade Flow hourly pull -> parse -> push cycle

[Service]
User=ubuntu
Group=ubuntu
Type=oneshot
WorkingDirectory=%HOME%/wa-trade-bot
ExecStart=/bin/bash %HOME%/wa-trade-bot/run-cycle.sh
StandardOutput=append:%HOME%/wa-trade-bot/logs/cycle.log
StandardError=append:%HOME%/wa-trade-bot/logs/cycle.log
