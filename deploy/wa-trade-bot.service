[Unit]
Description=Trade Flow bot setup UI
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
Group=ubuntu
Type=simple
WorkingDirectory=%HOME%/wa-trade-bot
EnvironmentFile=%HOME%/wa-trade-bot/.env
ExecStart=/usr/bin/node %HOME%/wa-trade-bot/server.js
Restart=always
RestartSec=10
# Secrets live in %HOME%/wa-trade-bot/.env (mode 600), loaded via EnvironmentFile.
# ADMIN_PASSWORD must be set there before first start.

[Install]
WantedBy=multi-user.target
